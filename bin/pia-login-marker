#!/usr/bin/env python3
"""Private login-result handoff. All marker access is relative to a verified fd."""
import os
from pathlib import Path
import stat
import subprocess
import sys

NAME = "omarchy-pia-login"
LIMIT = 4096


def runtime_fd():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime.startswith("/"):
        raise ValueError("XDG_RUNTIME_DIR must be an absolute, owner-only directory")
    # Reject symlinks in every component, and keep the verified directory open
    # so later marker operations cannot be redirected by pathname replacement.
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in runtime.split("/"):
            if not part:
                continue
            if part in (".", ".."):
                raise ValueError("XDG_RUNTIME_DIR must not contain dot components")
            next_fd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd)
            os.close(fd)
            fd = next_fd
        info = os.fstat(fd)
        if info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ValueError("XDG_RUNTIME_DIR must be owned by the current user with mode 0700")
        return fd
    except BaseException:
        os.close(fd)
        raise


def checked(info):
    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
        raise ValueError("unsafe login marker: expected an owned, single-link file with mode 0600")
    return info


def remove(directory, expected):
    current = checked(os.stat(NAME, dir_fd=directory, follow_symlinks=False))
    if (current.st_dev, current.st_ino) != (expected.st_dev, expected.st_ino):
        raise ValueError("login marker changed during access")
    # unlinkat never follows the final component. The private parent excludes
    # other users from changing entries between this check and unlink.
    os.unlink(NAME, dir_fd=directory)


def operate(directory, operation):
    if operation == "check":
        return 0
    if operation == "write":
        data = sys.stdin.buffer.read(LIMIT + 1)
        if not data.endswith(b"\n") or len(data) > LIMIT:
            raise ValueError("invalid login marker data")
        fd = os.open(NAME, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                     0o600, dir_fd=directory)
        with os.fdopen(fd, "wb") as marker:
            os.fchmod(marker.fileno(), 0o600)
            marker.write(data)
    elif operation in ("read", "clear"):
        try:
            fd = os.open(NAME, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=directory)
        except FileNotFoundError:
            return 3 if operation == "read" else 0
        with os.fdopen(fd, "rb") as marker:
            info = checked(os.fstat(marker.fileno()))
            if operation == "read":
                data = marker.read(LIMIT + 1)
                # A poll can see an exclusively created file before its writer
                # finishes. Leave incomplete results for the next poll.
                if not data.endswith(b"\n") or len(data) > LIMIT:
                    return 3
            remove(directory, info)
        if operation == "read":
            sys.stdout.buffer.write(data)
    elif operation == "launch":
        operate(directory, "clear")
        subprocess.Popen([
            "omarchy-launch-tui", "--app-id=pia-login", "bash",
            str(Path(__file__).resolve().with_name("pia-login")),
            sys.argv[2], NAME, sys.argv[3],
        ], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, start_new_session=True)
    else:
        raise ValueError("unknown marker operation")
    return 0


def main():
    directory = runtime_fd()
    try:
        return operate(directory, sys.argv[1])
    finally:
        os.close(directory)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, IndexError) as error:
        print(f"PIA login marker: {error}", file=sys.stderr)
        sys.exit(1)
