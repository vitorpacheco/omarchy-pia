#!/bin/bash
# Interactive login for Private Internet Access, launched in a terminal by the
# Omarchy bar widget. piactl only accepts credentials from a file, so this
# collects them with gum, writes them to a private temp file, hands it to
# piactl and shreds it again.

set -uo pipefail

CTL="${1:-piactl}"
# A nonempty second argument enables the fixed, private runtime marker.
MARKER="${2:-}"
MARKER_HELPER="$(dirname -- "${BASH_SOURCE[0]}")/pia-login-marker"
if [[ -n $MARKER ]]; then
  python3 "$MARKER_HELPER" check || exit 1
fi

# The panel passes its resolved language; standalone use follows the same
# LC_ALL > LC_MESSAGES > LANG precedence and falls back to English.
login_locale="${3:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
login_locale="${login_locale,,}"
login_language="${login_locale%%[-_.@]*}"
declare -A messages=(
  [missing]="piactl not found at '%s'. Install the PIA client first (yay -S piavpn-bin)."
  [close]="Press any key to close."
  [title]="Private Internet Access login"
  [privacy]="Your credentials are only written to a private temp file for piactl and removed right after."
  [username]="Username: "
  [no_username]="No username given."
  [password]="Password: "
  [no_password]="No password given."
  [success]="Logged in as %s. You can close this window."
  [already]="Already logged in as %s. Log out first to switch accounts."
  [failed]="Login failed."
)
case "$login_language" in
  es)
    messages[missing]="No se encontró piactl en '%s'. Instala primero el cliente de PIA (yay -S piavpn-bin)."
    messages[close]="Pulsa cualquier tecla para cerrar."
    messages[title]="Inicio de sesión en Private Internet Access"
    messages[privacy]="Tus credenciales solo se guardan en un archivo temporal privado para piactl y se eliminan inmediatamente después."
    messages[username]="Usuario: "
    messages[no_username]="No se indicó un usuario."
    messages[password]="Contraseña: "
    messages[no_password]="No se indicó una contraseña."
    messages[success]="Sesión iniciada como %s. Puedes cerrar esta ventana."
    messages[already]="Ya hay una sesión iniciada como %s. Cierra la sesión antes de cambiar de cuenta."
    messages[failed]="Error al iniciar sesión."
    ;;
  pt)
    messages[missing]="piactl não encontrado em '%s'. Instale primeiro o cliente da PIA (yay -S piavpn-bin)."
    messages[close]="Pressione qualquer tecla para fechar."
    messages[title]="Login na Private Internet Access"
    messages[privacy]="Suas credenciais são gravadas apenas em um arquivo temporário privado para o piactl e removidas logo depois."
    messages[username]="Usuário: "
    messages[no_username]="Nenhum usuário informado."
    messages[password]="Senha: "
    messages[no_password]="Nenhuma senha informada."
    messages[success]="Conectado como %s. Você pode fechar esta janela."
    messages[already]="Já existe uma sessão como %s. Saia antes de trocar de conta."
    messages[failed]="Falha no login."
    ;;
esac

# Format strings come only from the catalog; credentials are never evaluated.
tr_login() { local key="$1"; shift; printf "${messages[$key]}" "$@"; }

mark() {
  [[ -n $MARKER ]] || return 0
  printf '%s\n' "$1" | python3 "$MARKER_HELPER" write
}

if ! command -v "$CTL" >/dev/null 2>&1 && [[ ! -x $CTL ]]; then
  printf '%s\n' "$(tr_login missing "$CTL")" >&2
  read -rsn1 -p "$(tr_login close)" _
  exit 1
fi

echo
gum style --bold "$(tr_login title)"
echo "$(tr_login privacy)"
echo

username=$(gum input --placeholder "p1234567" --prompt "$(tr_login username)") || exit 1
[[ -n $username ]] || { echo "$(tr_login no_username)" >&2; exit 1; }
password=$(gum input --password --prompt "$(tr_login password)") || exit 1
[[ -n $password ]] || { echo "$(tr_login no_password)" >&2; exit 1; }

credentials=$(mktemp --tmpdir pia-login.XXXXXX) || exit 1
chmod 600 "$credentials"
cleanup() {
  if command -v shred >/dev/null 2>&1; then shred -u "$credentials" 2>/dev/null || rm -f "$credentials"
  else rm -f "$credentials"
  fi
}
trap cleanup EXIT

printf '%s\n%s\n' "$username" "$password" >"$credentials"

echo
echo
output=$("$CTL" login "$credentials" 2>&1)
status=$?
[[ -n $output ]] && echo "$output"

if (( status == 0 )); then
  mark "$username" || exit 1
  gum style --foreground 2 "$(tr_login success "$username")"
  sleep 1.5
  exit 0
fi

# piactl refuses a second login while a session exists; treat that as success
# and record the account it names.
if [[ $output =~ Already\ logged\ into\ account[[:space:]]+([^[:space:]]+) ]]; then
  mark "${BASH_REMATCH[1]}" || exit 1
  gum style --foreground 3 "$(tr_login already "${BASH_REMATCH[1]}")"
  sleep 2
  exit 0
fi

echo
gum style --foreground 1 "$(tr_login failed)"
read -rsn1 -p "$(tr_login close)" _
exit 1
